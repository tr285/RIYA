[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "riya-ai"
version = "0.1.0"
description = "RIYA - An offline-first, cross-platform personal AI assistant"
requires-python = ">=3.10"
authors = [
    { name = "Tularam" }
]
dependencies = [
    "numpy>=1.24",
    "sentence-transformers>=2.2",
]

[project.optional-dependencies]
voice = [
    "sounddevice>=0.4",
    "soundfile>=0.12",
    "faster-whisper>=1.0",
]

[tool.setuptools.packages.find]
include = ["core*"]

[tool.pytest.ini_options]
testpaths = ["tests"]
