def apply_migrations(
    connection: sqlite3.Connection,
    target_version: int = CURRENT_SCHEMA_VERSION,
) -> list[int]:
    """Apply pending migrations inside an atomic transaction."""
    if target_version < 0 or target_version > CURRENT_SCHEMA_VERSION:
        raise MigrationError(f"Unsupported target schema version: {target_version}")

    applied: list[int] = []
    connection.execute("PRAGMA foreign_keys = ON")

    started_tx = False
    if not connection.in_transaction:
        connection.execute("BEGIN IMMEDIATE")
        started_tx = True

    try:
        _ensure_migrations_table(connection)
        current_rows = connection.execute(
            "SELECT version FROM schema_migrations"
        ).fetchall()
        applied_versions = {int(row[0]) for row in current_rows}

        for migration in MIGRATIONS:
            if migration.version > target_version:
                break
            if migration.version in applied_versions:
                continue
            migration.up(connection)
            connection.execute(
                """
                INSERT INTO schema_migrations (version, name, applied_at)
                VALUES (?, ?, ?)
                """,
                (migration.version, migration.name, _utc_now()),
            )
            applied.append(migration.version)

        if started_tx:
            connection.commit()
    except Exception:
        if started_tx:
            connection.rollback()
        raise

    return applied


def rollback_migration(
    connection: sqlite3.Connection,
    target_version: int = 1,
) -> list[int]:
    """Roll back applied migrations down to target_version inside a transaction."""
    if target_version < 0 or target_version > CURRENT_SCHEMA_VERSION:
        raise MigrationError(f"Unsupported rollback target version: {target_version}")

    rolled_back: list[int] = []
    connection.execute("PRAGMA foreign_keys = ON")

    started_tx = False
    if not connection.in_transaction:
        connection.execute("BEGIN IMMEDIATE")
        started_tx = True

    try:
        if not _table_exists(connection, "schema_migrations"):
            if started_tx:
                connection.commit()
            return rolled_back

        current_rows = connection.execute(
            "SELECT version FROM schema_migrations"
        ).fetchall()
        applied_versions = {int(row[0]) for row in current_rows}

        for migration in reversed(MIGRATIONS):
            if migration.version <= target_version:
                continue
            if migration.version not in applied_versions:
                continue
            migration.down(connection)
            connection.execute(
                "DELETE FROM schema_migrations WHERE version = ?",
                (migration.version,),
            )
            rolled_back.append(migration.version)

        if started_tx:
            connection.commit()
    except Exception:
        if started_tx:
            connection.rollback()
        raise

    return rolled_back
