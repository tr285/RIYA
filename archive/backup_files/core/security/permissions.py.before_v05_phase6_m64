class PermissionErrorBase(PermissionError):
    """Base error for RIYA permission and trust enforcement."""


class PermissionDeniedError(PermissionErrorBase):
    """Raised when an action is explicitly denied or default-denied."""


class PermissionAuthorityError(PermissionErrorBase):
    """Raised when an untrusted actor attempts a privileged permission mutation."""


class PermissionConflictError(PermissionErrorBase):
    """Raised when attempting to grant over an active DENY rule without revoking it."""


class PermissionDecision(str, Enum):
    ALLOW = "allow"
    CONFIRM = "confirm"
    DENY = "deny"
    NOT_CONFIGURED = "not_configured"


class PermissionLifetime(str, Enum):
    ONE_TIME = "one_time"
    SESSION = "session"
    PERSISTENT = "persistent"
    TIME_LIMITED = "time_limited"


