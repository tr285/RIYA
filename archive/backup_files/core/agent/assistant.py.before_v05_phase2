from typing import Any

from core.agent.context import ConversationContext
from core.agent.executor import CommandExecutor
from core.agent.intent import IntentDetector, IntentType
from core.agent.planner import AgentPlanner

from core.identity.context import (
    ExecutionContext,
    ExecutionContextScope,
    get_current_execution_context,
)
from core.identity.errors import IdentityError, InvalidIdentityError, MissingIdentityError
from core.identity.manager import (
    ConversationHistoryStore,
    IdentityManager,
    UserPermissionStore,
