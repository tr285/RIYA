from __future__ import annotations

from dataclasses import dataclass, field
import inspect
import re
from typing import Any, Callable, Dict, Optional


MAX_PARAM_STRING_LENGTH = 200_000
_TOOL_NAME_PATTERN = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_]{0,63}$")
_PARAM_NAME_PATTERN = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_]{0,63}$")


@dataclass(frozen=True)
class ParameterSchema:
    """Type, nullability, size, and range constraints for a tool parameter."""

    types: tuple[type, ...] = (str,)
    required: bool = True
    allow_none: bool = False
    allow_empty: bool = False
    max_length: int = 1024
    min_value: int | float | None = None
    max_value: int | float | None = None
    allow_newlines: bool = False


BUILTIN_TOOL_SCHEMAS: dict[str, dict[str, ParameterSchema]] = {
