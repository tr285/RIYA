from dataclasses import dataclass

from core.ai.safety import MAX_CONTEXT_CHARS, sanitize_untrusted_text


ALLOWED_CONVERSATION_ROLES = frozenset({"user", "assistant"})


@dataclass
class ConversationMessage:
    role: str
    content: str


class ConversationContext:
    """
    Short-term conversation context.

    This data lives only for the current RIYA process/session.
    It is NOT written to the persistent memory database.
    """

    def __init__(
        self,
        max_messages: int = 12,
        max_message_chars: int = 1000,
        max_total_chars: int = MAX_CONTEXT_CHARS,
    ):
        if max_messages < 2:
            raise ValueError(
                "max_messages must be at least 2."
            )
        if max_message_chars <= 0:
            raise ValueError("max_message_chars must be positive.")
        if max_total_chars < max_message_chars:
            raise ValueError(
                "max_total_chars must be at least max_message_chars."
            )

        self.max_messages = max_messages
        self.max_message_chars = max_message_chars
        self.max_total_chars = max_total_chars
        self._messages: list[ConversationMessage] = []

    def add_user(self, content: str) -> None:
        self._add(
            role="user",
            content=content,
        )

    def add_assistant(self, content: str) -> None:
        self._add(
            role="assistant",
            content=content,
        )

    def _add(
        self,
        role: str,
        content: str,
    ) -> None:
        if role not in ALLOWED_CONVERSATION_ROLES:
            raise ValueError(f"Unsupported conversation role: {role!r}")

        if not isinstance(content, str):
            raise ValueError("Conversation content must be a string.")

        cleaned = sanitize_untrusted_text(
            content,
            max_chars=self.max_message_chars,
            allow_newlines=True,
            neutralize_roles=True,
        ).strip()

        if not cleaned:
            return

        self._messages.append(
            ConversationMessage(
                role=role,
                content=cleaned,
            )
        )

        self._trim()

    def _trim(self) -> None:
        if len(self._messages) > self.max_messages:
            self._messages = self._messages[-self.max_messages :]

        while len(self._messages) > 1 and (
            sum(len(message.content) for message in self._messages)
            > self.max_total_chars
        ):
            self._messages.pop(0)

    def messages(self) -> list[ConversationMessage]:
        return list(self._messages)

    def clear(self) -> None:
        self._messages.clear()

    def __len__(self) -> int:
        return len(self._messages)

    def format_for_prompt(self) -> str:
        if not self._messages:
            return ""

        lines = []

        for message in self._messages:
            if message.role == "user":
                speaker = "User"
            else:
                speaker = "RIYA"

            lines.append(
                f"{speaker}: {message.content}"
            )

        return "\n".join(lines)
