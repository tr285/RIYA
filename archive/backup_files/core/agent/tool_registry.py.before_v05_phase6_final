@dataclass(frozen=True)
class ToolPermission:
    """Declarative permission and risk contract associated with a tool."""

    permission_key: str
    risk_level: RiskLevel = RiskLevel.LOW
    requires_confirmation: bool = False
    sandboxed: bool = True
    notes: str = ""


class ToolValidator:
    """Custom runtime parameter validator attached to a ToolDefinition."""

    def __init__(self, check_fn: Callable[[dict[str, Any]], None] | None = None):
        self._check_fn = check_fn

    def validate(self, parameters: dict[str, Any]) -> None:
        if self._check_fn is not None:
            self._check_fn(parameters)


@dataclass
class ToolDefinition:
    """Rich metadata definition for registering a capability into ToolRegistry."""

    name: str
    description: str
    function: Callable
    parameters: set[str] = field(default_factory=set)
    parameter_schemas: dict[str, ParameterSchema] = field(default_factory=dict)
    permission: ToolPermission | None = None
    risk_level: RiskLevel = RiskLevel.LOW
    input_schema: dict[str, Any] = field(default_factory=dict)
    output_schema: dict[str, Any] = field(default_factory=dict)
    timeout_seconds: float | None = None
    category: str = "general"
    offline_safe: bool = True
    validator: ToolValidator | None = None


@dataclass
class ToolResult:
    """Structured tool execution result helper."""

    status: str
    tool: str
    parameters: dict[str, Any] = field(default_factory=dict)
    result: Any = None
    verification: dict[str, Any] | None = None
    reason: str = ""
    error: str = ""
    risk_level: str = RiskLevel.LOW.value
    duration_ms: float = 0.0
    timed_out: bool = False

    def to_dict(self) -> dict[str, Any]:
        payload: dict[str, Any] = {
            "status": self.status,
            "tool": self.tool,
            "parameters": self.parameters,
            "risk_level": self.risk_level,
            "duration_ms": self.duration_ms,
        }
        if self.result is not None:
            payload["result"] = self.result
        if self.verification is not None:
            payload["verification"] = self.verification
        if self.reason:
            payload["reason"] = self.reason
        if self.error:
            payload["error"] = self.error
        if self.timed_out:
            payload["timed_out"] = True
        return payload


@dataclass
class Tool:
    """A capability available to RIYA."""

    name: str
    description: str
    function: Callable
    parameters: set[str]
    parameter_schemas: dict[str, ParameterSchema] = field(default_factory=dict)
    risk_level: RiskLevel = RiskLevel.LOW
    permission: ToolPermission | None = None
    input_schema: dict[str, Any] = field(default_factory=dict)
    output_schema: dict[str, Any] = field(default_factory=dict)
    timeout_seconds: float | None = None
    category: str = "general"
    offline_safe: bool = True
    validator: ToolValidator | None = None

    def to_definition(self) -> ToolDefinition:
        return ToolDefinition(
            name=self.name,
            description=self.description,
            function=self.function,
            parameters=set(self.parameters),
            parameter_schemas=dict(self.parameter_schemas),
            permission=self.permission,
            risk_level=self.risk_level,
            input_schema=dict(self.input_schema),
            output_schema=dict(self.output_schema),
            timeout_seconds=self.timeout_seconds,
            category=self.category,
            offline_safe=self.offline_safe,
            validator=self.validator,
        )


def _check_string_safety(
    name: str,
    param_name: str,
    value: str,
    *,
    allow_empty: bool,
    max_length: int,
    allow_newlines: bool,
) -> None:
    if len(value) > max_length:
        raise ValueError(
            f"Parameter '{param_name}' for '{name}' exceeds maximum length ({max_length})."
        )

    if not allow_empty and not value.strip():
        raise ValueError(
            f"Parameter '{param_name}' for '{name}' cannot be empty."
        )

    for char in value:
        code = ord(char)
        if code == 0 or code == 127:
            raise ValueError(
                f"Parameter '{param_name}' for '{name}' contains disallowed control characters."
            )
        if code < 32:
            if allow_newlines and char in ("\n", "\r", "\t"):
                continue
            raise ValueError(
                f"Parameter '{param_name}' for '{name}' contains disallowed control characters."
            )


class ToolRegistry:
    """Registry of tools available to the RIYA agent."""

    def __init__(self):
        self._tools: Dict[str, Tool] = {}

    def register(
        self,
        name: str,
        description: str,
        function: Callable,
        parameters: Optional[set[str]] = None,
        parameter_schemas: Optional[dict[str, ParameterSchema]] = None,
        *,
        risk_level: RiskLevel = RiskLevel.LOW,
        permission: Optional[ToolPermission] = None,
        input_schema: Optional[dict[str, Any]] = None,
        output_schema: Optional[dict[str, Any]] = None,
        timeout_seconds: Optional[float] = None,
        category: str = "general",
        offline_safe: bool = True,
        validator: Optional[ToolValidator] = None,
    ) -> None:
        """Register a tool, its accepted parameters, and validation schemas."""

        if not isinstance(name, str) or not _TOOL_NAME_PATTERN.fullmatch(name):
            raise ValueError(f"Invalid tool name: {name!r}")

        if name in FORBIDDEN_PERMISSION_ADMIN_TOOLS:
            raise ValueError(
                f"Privilege/permission management action '{name}' cannot be registered as an AI tool."
            )

        if not isinstance(description, str) or not description.strip():
            raise ValueError(f"Invalid description for tool: {name}")

        if not callable(function):
            raise ValueError(f"Tool function for '{name}' must be callable.")

        if name in self._tools:
            raise ValueError(
                f"Tool already registered: {name}"
            )

        if timeout_seconds is not None and (
            isinstance(timeout_seconds, bool)
            or not isinstance(timeout_seconds, (int, float))
            or timeout_seconds <= 0
        ):
            raise ValueError(f"Invalid timeout_seconds for '{name}': {timeout_seconds!r}")

        normalized_parameters = (
            set(parameters) if parameters is not None else set()
        )

        for param_name in normalized_parameters:
            if not isinstance(param_name, str) or not _PARAM_NAME_PATTERN.fullmatch(param_name):
                raise ValueError(f"Invalid parameter name: {param_name!r}")

        reserved = sorted(RESERVED_TOOL_PARAMETERS & normalized_parameters)
        if reserved:
            raise ValueError(
                f"Reserved security/identity parameters cannot be registered as tool parameters: {reserved}"
            )

        resolved_schemas: dict[str, ParameterSchema] = {}
        if parameter_schemas is not None:
            if set(parameter_schemas) != normalized_parameters:
                raise ValueError(
                    f"parameter_schemas keys must match declared parameters for '{name}'."
                )
            resolved_schemas = dict(parameter_schemas)
        else:
            builtin = BUILTIN_TOOL_SCHEMAS.get(name)
            if builtin is not None and set(builtin) == normalized_parameters:
                resolved_schemas = dict(builtin)

        self._tools[name] = Tool(
            name=name,
            description=description,
            function=function,
            parameters=normalized_parameters,
            parameter_schemas=resolved_schemas,
            risk_level=permission.risk_level if permission is not None else risk_level,
            permission=permission,
            input_schema=dict(input_schema or {}),
            output_schema=dict(output_schema or {}),
            timeout_seconds=float(timeout_seconds) if timeout_seconds is not None else None,
            category=category,
            offline_safe=offline_safe,
            validator=validator,
        )

    def register_definition(self, definition: ToolDefinition) -> None:
        """Register a capability using a structured ToolDefinition contract."""
        self.register(
            name=definition.name,
            description=definition.description,
            function=definition.function,
            parameters=set(definition.parameters),
            parameter_schemas=dict(definition.parameter_schemas) if definition.parameter_schemas else None,
            risk_level=definition.risk_level,
            permission=definition.permission,
            input_schema=definition.input_schema,
            output_schema=definition.output_schema,
            timeout_seconds=definition.timeout_seconds,
            category=definition.category,
            offline_safe=definition.offline_safe,
            validator=definition.validator,
        )

    def get(self, name: str) -> Optional[Tool]:
        """Get a registered tool."""

        if not isinstance(name, str):
            return None

        return self._tools.get(name)

    def list_tools(self) -> list[Tool]:
        """Return all registered tools."""

        return list(self._tools.values())

    def has(self, name: str) -> bool:
        """Check whether a tool exists."""

        return isinstance(name, str) and name in self._tools

    def validate_parameters(
        self,
        name: str,
        parameters: dict[str, Any],
    ) -> None:
        """Validate parameter names, required fields, types, bounds, and safety."""

        tool = self.get(name)

        if tool is None:
            raise ValueError(
                f"Unknown RIYA tool: {name}"
            )

        if not isinstance(parameters, dict):
            raise ValueError(f"Parameters for '{name}' must be an object.")

        if not all(isinstance(key, str) for key in parameters):
            raise ValueError(f"Parameter names for '{name}' must be strings.")

        reserved = sorted(RESERVED_TOOL_PARAMETERS & set(parameters))
        if reserved:
            raise ValueError(
                f"Reserved security/identity parameters cannot be supplied as tool parameters: {reserved}"
            )

        unexpected = set(parameters) - tool.parameters

        if unexpected:
            raise ValueError(
                f"Unexpected parameters for '{name}': "
                f"{sorted(unexpected)}. "
                f"Allowed: {sorted(tool.parameters)}"
            )

        # Check required parameters from explicit schemas or Python signature.
        if tool.parameter_schemas:
            required = {
                param_name
                for param_name, schema in tool.parameter_schemas.items()
                if schema.required
            }
        else:
            required = self._required_signature_parameters(tool.function)

        missing = required - set(parameters)
        if missing:
            raise ValueError(
                f"Missing required parameters for '{name}': {sorted(missing)}"
            )

        # Validate values strictly.
        for param_name, value in parameters.items():
            schema = tool.parameter_schemas.get(param_name)
            if schema is not None:
                self._validate_with_schema(name, param_name, value, schema)
            else:
                self._validate_generic_value(name, param_name, value, tool.function)

        if tool.validator is not None:
            tool.validator.validate(parameters)

    @staticmethod
    def _required_signature_parameters(function: Callable) -> set[str]:
        try:
            signature = inspect.signature(function)
        except (TypeError, ValueError):
            return set()

        return {
            param.name
            for param in signature.parameters.values()
            if param.kind
            in (
                inspect.Parameter.POSITIONAL_OR_KEYWORD,
                inspect.Parameter.KEYWORD_ONLY,
            )
            and param.default is inspect.Parameter.empty
        }

    @staticmethod
    def _validate_with_schema(
        tool_name: str,
        param_name: str,
        value: Any,
        schema: ParameterSchema,
    ) -> None:
        if value is None:
            if schema.allow_none:
                return
            raise ValueError(
                f"Parameter '{param_name}' for '{tool_name}' cannot be null."
            )

        if isinstance(value, bool) and bool not in schema.types:
            raise ValueError(
                f"Invalid type for parameter '{param_name}' in '{tool_name}': boolean is not allowed."
            )

        if not isinstance(value, schema.types):
            expected = ", ".join(t.__name__ for t in schema.types)
            raise ValueError(
                f"Parameter '{param_name}' for '{tool_name}' must be of type {expected}."
            )

        if isinstance(value, str):
            _check_string_safety(
                tool_name,
                param_name,
                value,
                allow_empty=schema.allow_empty,
                max_length=schema.max_length,
                allow_newlines=schema.allow_newlines,
            )

        if isinstance(value, (int, float)) and not isinstance(value, bool):
            if schema.min_value is not None and value < schema.min_value:
                raise ValueError(
                    f"Parameter '{param_name}' for '{tool_name}' must be >= {schema.min_value}."
                )
            if schema.max_value is not None and value > schema.max_value:
                raise ValueError(
                    f"Parameter '{param_name}' for '{tool_name}' must be <= {schema.max_value}."
                )

    @staticmethod
    def _validate_generic_value(
        tool_name: str,
        param_name: str,
        value: Any,
        function: Callable,
    ) -> None:
        if value is None:
            try:
                param = inspect.signature(function).parameters.get(param_name)
                if param is not None and param.default is None:
                    return
            except (TypeError, ValueError):
                pass
            raise ValueError(
                f"Parameter '{param_name}' for '{tool_name}' cannot be null."
            )

        if isinstance(value, (dict, list, set, tuple)):
            raise ValueError(
                f"Nested or collection value is not allowed for parameter '{param_name}' in '{tool_name}'."
            )

        if not isinstance(value, (str, int, float, bool)):
            raise ValueError(
                f"Unsupported value type for parameter '{param_name}' in '{tool_name}'."
            )

        if isinstance(value, str):
            _check_string_safety(
                tool_name,
                param_name,
                value,
                allow_empty=True,
                max_length=MAX_PARAM_STRING_LENGTH,
                allow_newlines=True,
            )
