    # =========================================================
    # PLANNING
    # =========================================================

    def plan(
        self,
        goal: str,
    ) -> Plan:

        return Plan(
            goal=goal
        )

    def create_ai_plan(
        self,
        goal: str,
        ai_runtime,
    ):

        from core.agent.planner import (
            AgentPlanner,
        )

        planner = AgentPlanner(
            ai_runtime,
            self.tools,
        )

        return planner.create_plan(
            goal
        )

    # =========================================================
    # TOOL INFORMATION
    # =========================================================

    def available_tools(self):

        return self.tools.list_tools()

    def set_identity(self, identity: Any) -> None:
        """Bind or clear the active authenticated identity on the central executor."""

        self.executor.set_identity(identity)

    @property
    def current_identity(self):
        return self.executor._active_identity

    # =========================================================
    # SINGLE TOOL EXECUTION
    # =========================================================

    def execute(
        self,
        tool_name: str,
        confirmation_token: str | None = None,
        user_context: Any = _UNSET,
        **parameters,
    ):
        """
        Execute a single RIYA tool.

        All execution goes through ToolExecutor,
        including security and verification.
        """

        return self.executor.execute(
            tool_name,
            confirmation_token=confirmation_token,
            user_context=user_context,
            **parameters,
        )

    # =========================================================
    # MULTI-STEP PLAN EXECUTION
    # =========================================================

    def execute_plan(
        self,
        plan,
        user_context: Any = _UNSET,
    ):
        """
        Execute a complete multi-step RIYA plan.

        ToolExecutor handles:

        - security
        - confirmation
        - execution
        - verification
        - failure handling
        """

        return self.executor.execute_plan(
            plan,
            user_context=user_context,
        )

    def cancel_confirmation(
        self,
        confirmation_token: str | None,
    ) -> None:
        """Cancel a pending confirmation through the central executor."""

        self.executor.cancel_confirmation(confirmation_token)

    # =========================================================
    # SIMPLE DECISION + EXECUTION
    # =========================================================

    def decide_and_execute(
        self,
        request: str,
        ai_runtime,
        user_context: Any = _UNSET,
    ):
        """
        Use the AI decision engine for a request.

        Returns None when no tool is required.
        """

        from core.agent.tool_decision import (
            ToolDecisionEngine,
        )

        decision_engine = ToolDecisionEngine(
            ai_runtime,
            self.tools,
        )

        decision = decision_engine.decide(
            request
        )

        if decision.tool is None:
            return None

        if (
            not isinstance(decision.tool, str)
            or not isinstance(decision.parameters, dict)
            or not all(isinstance(key, str) for key in decision.parameters)
        ):
            raise ValueError(
                "Tool decisions cannot supply invalid parameter structures."
            )

        self.tools.validate_parameters(
            decision.tool,
            decision.parameters,
        )

        return self.execute(
            decision.tool,
            confirmation_token=None,
            user_context=user_context,
            **decision.parameters,
        )
