import queue
import threading
from typing import Any, Callable

import numpy as np

from core.ai.safety import InferenceCancelledError, strip_unsafe_control_chars
from core.identity.manager import IdentityManager
from core.identity.models import AuthenticatedIdentity
from core.security.permissions import PermissionManager
from core.voice.audio_input import MicrophoneStream
from core.voice.audio_output import AudioOutputPlayer
from core.voice.config import VoiceConfig
from core.voice.errors import VoiceError, VoicePermissionError
from core.voice.personality import prepare_text_for_speech, split_into_speech_chunks
from core.voice.session import TranscriptEntry, VoiceSession
from core.voice.state import ACTIVE_STATES, VoiceState, VoiceStateMachine
from core.voice.stt import LocalSTT, TranscriptionResult
from core.voice.tts import LocalTTS
