logger = logging.getLogger("riya.voice.orchestrator")

_YES_TOKENS = frozenset(
    {
        "yes",
        "y",
        "yeah",
        "yep",
        "sure",
        "ok",
        "okay",
        "confirm",
        "do it",
        "proceed",
        "go ahead",
        "please proceed",
        "continue",
    }
)
_NO_TOKENS = frozenset({"no", "n", "nope", "cancel", "stop", "don't", "dont"})


class VoiceOrchestrator:
    """Coordinates real-time voice I/O, barge-in, mode switching, and RIYAAssistant."""

    def __init__(
        self,
        assistant: Any,
        config: VoiceConfig | None = None,
        *,
        stt: LocalSTT | Any | None = None,
        tts: LocalTTS | Any | None = None,
        player: AudioOutputPlayer | None = None,
        mic_factory: Callable[[VoiceConfig], MicrophoneStream] | None = None,
        vad_backend: Any | None = None,
        session: VoiceSession | None = None,
        identity_manager: Any | None = None,
        permission_manager: Any | None = None,
        identity: Any | None = None,
    ):
        self.assistant = assistant
        self.config = config or VoiceConfig()
        self.state_machine = session.state_machine if session is not None else VoiceStateMachine()
        self.session = session or VoiceSession(
            self.config,
            state_machine=self.state_machine,
            mic_factory=mic_factory,
        )
        self._stt = stt
        self._custom_tts = tts
        self.player = player or AudioOutputPlayer(self.config, tts=tts)
        self._vad_backend = vad_backend
        self.segmenter = UtteranceSegmenter(self.config, backend=vad_backend)
        raw_id_mgr = identity_manager if identity_manager is not None else getattr(
            assistant, "identity_manager", None
        )
        self.identity_manager = (
            raw_id_mgr if isinstance(raw_id_mgr, IdentityManager) else None
        )
        raw_pm = permission_manager
        if raw_pm is None:
            candidate_pm = getattr(assistant, "permission_manager", None)
            if isinstance(candidate_pm, PermissionManager):
                raw_pm = candidate_pm
        self.permission_manager = raw_pm
        self._explicit_identity = identity

        self._lock = threading.RLock()
        self._mode: str = "text"  # "text" | "voice"
        self._turn_id: int = 0
        self._turn_cancel_event = threading.Event()
        self._stop_threads = threading.Event()
        self._utterance_queue: queue.Queue[tuple[np.ndarray, int]] = queue.Queue(maxsize=16)

        self._audio_thread: threading.Thread | None = None
        self._turn_thread: threading.Thread | None = None
        self._last_error: str | None = None
        self._streaming_text: str = ""
        self._active_task_progress: dict[str, Any] | None = None
        self._task_progress_history: list[dict[str, Any]] = []
        self._last_task_result: Any = None
        self._observers: list[Callable[[], None]] = []
        if self.permission_manager is not None and hasattr(
            self.permission_manager, "register_revocation_listener"
        ):
            self.permission_manager.register_revocation_listener(
                self._on_permission_revoked
            )

    def _resolve_active_identity(self) -> Any | None:
        if self._explicit_identity is not None:
            return self._explicit_identity
        candidate = getattr(self.assistant, "current_identity", None)
        if isinstance(candidate, AuthenticatedIdentity):
            return candidate
        return None

    def _resolve_permission_manager(self) -> Any | None:
        if self.permission_manager is not None:
            return self.permission_manager
        candidate = getattr(self.assistant, "permission_manager", None)
        if isinstance(candidate, PermissionManager):
            return candidate
        return None

    def _on_permission_revoked(
        self,
        user_id: str,
        permission_key: str | None,
        session_id: str | None,
        reason: str,
    ) -> None:
        identity = self._resolve_active_identity()
        if identity is None or getattr(identity, "user_id", None) != user_id:
            return
        if session_id is not None and getattr(identity, "session_id", None) != session_id:
            return
        if permission_key in {None, "voice.microphone"} and self.mode == "voice":
            self.stop_voice_mode()
        elif permission_key in {None, "voice.speaker"}:
            self.player.stop()
            self._notify_observers()

    def _enforce_voice_permission(
        self,
        permission_key: str,
        *,
        resource: str = "*",
        consume: bool = False,
    ) -> None:
        pm = self._resolve_permission_manager()
        if pm is None:
            return
        identity = self._resolve_active_identity()
        if identity is None:
            raise VoicePermissionError(
                f"Authenticated user session required before using {permission_key}.",
                user_message="Please sign in before using voice features.",
            )
        if consume:
            eval_res = pm.consume_if_authorized(
                identity,
                permission_key,
                resource_or_target=resource,
                actor="voice",
            )
        else:
            eval_res = pm.evaluate(
                identity,
                permission_key,
                resource_or_target=resource,
                actor="voice",
            )
        if eval_res.blocked:
            raise VoicePermissionError(
                eval_res.reason,
                user_message=eval_res.reason,
            )

    def _enforce_voice_config_permissions(self, new_config: VoiceConfig) -> None:
        self._enforce_voice_permission("voice.config", resource="voice:config")
        dev_changed = (
            new_config.input_device != self.config.input_device
            or new_config.output_device != self.config.output_device
        )
        if dev_changed:
            targets = []
            if new_config.input_device != self.config.input_device:
                targets.append(f"device:{new_config.input_device or 'default_input'}")
            if new_config.output_device != self.config.output_device:
                targets.append(f"device:{new_config.output_device or 'default_output'}")
            for dev_target in targets:
                self._enforce_voice_permission("voice.device", resource=dev_target)

    # ------------------------------------------------------------------
    @property
    def mode(self) -> str:
        with self._lock:
            return self._mode

    @property
    def state(self) -> VoiceState:
        return self.state_machine.state

    @property
    def last_error(self) -> str | None:
        with self._lock:
            return self._last_error

    @property
    def stt(self) -> Any:
        if self._stt is None:
            self._stt = LocalSTT(
                model_size=self.config.stt_model,
                device="cpu",
                compute_type=self.config.stt_compute_type,
                cpu_threads=self.config.stt_cpu_threads,
                beam_size=self.config.stt_beam_size,
                download_root=self.config.stt_model_dir,
                local_files_only=True,
                max_transcript_chars=self.config.max_transcript_chars,
            )
        return self._stt

    def add_observer(self, callback: Callable[[], None]) -> None:
        with self._lock:
            self._observers.append(callback)

    def _notify_observers(self) -> None:
        with self._lock:
            callbacks = list(self._observers)
        for cb in callbacks:
            try:
                cb()
            except Exception:
                pass

    # ------------------------------------------------------------------
    def update_config(self, new_config: VoiceConfig) -> None:
        new_config.validate()
        with self._lock:
            self._enforce_voice_config_permissions(new_config)
            old = self.config
            self.config = new_config
            self.session.config = new_config
            self.player.update_config(new_config)
            if (
                old.stt_model != new_config.stt_model
                or old.stt_compute_type != new_config.stt_compute_type
                or old.stt_beam_size != new_config.stt_beam_size
                or old.stt_cpu_threads != new_config.stt_cpu_threads
                or old.stt_model_dir != new_config.stt_model_dir
            ):
                self._stt = None
            self.segmenter = UtteranceSegmenter(new_config, backend=self._vad_backend)
        self._notify_observers()

    # ------------------------------------------------------------------
    def start_voice_mode(self, *, background_workers: bool = True) -> None:
        """Start explicit microphone capture and voice loop."""

        with self._lock:
            self._last_error = None
            self._turn_cancel_event.clear()
            self._stop_threads.clear()
            self.segmenter.reset()

        self._enforce_voice_permission("voice.microphone", resource="voice:microphone", consume=True)
        self.session.start()

        with self._lock:
            self._mode = "voice"
            if background_workers:
                self._audio_thread = threading.Thread(
                    target=self._audio_capture_loop,
                    name="riya-voice-audio",
                    daemon=True,
                )
                self._turn_thread = threading.Thread(
                    target=self._turn_worker_loop,
                    name="riya-voice-turn",
                    daemon=True,
                )
                self._audio_thread.start()
                self._turn_thread.start()
        self._notify_observers()

    def stop_voice_mode(self) -> None:
        """Stop voice capture/playback cleanly and switch back to text mode."""

        with self._lock:
            self._turn_id += 1
            self._turn_cancel_event.set()
            self._stop_threads.set()
            self._mode = "text"
            audio_t = self._audio_thread
            turn_t = self._turn_thread
            self._audio_thread = None
            self._turn_thread = None

        self.player.stop()
        if hasattr(self.assistant, "cancel"):
            try:
                self.assistant.cancel()
            except Exception:
                pass

        while True:
            try:
                self._utterance_queue.get_nowait()
            except queue.Empty:
                break

        self.session.stop(to_error=False)

        for thread in (audio_t, turn_t):
            if thread is not None and thread is not threading.current_thread():
                thread.join(timeout=1.5)

        if hasattr(self.assistant, "reset_cancel"):
            try:
                self.assistant.reset_cancel()
            except Exception:
                pass
        self._notify_observers()

    def switch_mode(self, mode: str, *, background_workers: bool = True) -> str:
        """Seamlessly switch between 'text' and 'voice' without losing history."""

        normalized = str(mode).strip().lower()
        if normalized not in {"text", "voice"}:
            raise ValueError("Mode must be 'text' or 'voice'.")
        if normalized == "voice":
            if self.state == VoiceState.IDLE:
                self.start_voice_mode(background_workers=background_workers)
            else:
                with self._lock:
                    self._mode = "voice"
        else:
            if self.state != VoiceState.IDLE:
                self.stop_voice_mode()
            else:
                with self._lock:
                    self._mode = "text"
        self._notify_observers()
        return self.mode

    # ------------------------------------------------------------------
    def _is_turn_active(self, turn_id: int) -> bool:
        with self._lock:
            return (
                not self._turn_cancel_event.is_set()
                and turn_id == self._turn_id
                and self.state in ACTIVE_STATES
            )

    def interrupt(self, reason: str = "user_barge_in") -> None:
        """Interrupt ongoing speech/thinking immediately and prepare for new input."""

        with self._lock:
            self._turn_id += 1
            self._turn_cancel_event.set()
            current = self.state_machine.state

        self.player.stop()
        if hasattr(self.assistant, "cancel"):
            try:
                self.assistant.cancel()
            except Exception:
                pass

        if current in (VoiceState.SPEAKING, VoiceState.THINKING):
            if self.state_machine.try_transition(VoiceState.INTERRUPTED, reason):
                self.state_machine.try_transition(VoiceState.LISTENING, "ready_after_interrupt")
        self._notify_observers()

    # ------------------------------------------------------------------
    @property
    def streaming_text(self) -> str:
        with self._lock:
            return self._streaming_text

    def clear_error(self) -> None:
        with self._lock:
            self._last_error = None
        if hasattr(self.assistant, "clear_last_error"):
            try:
                self.assistant.clear_last_error()
            except Exception:
                pass
        self._notify_observers()

    def _emit_progressive_chunks(
        self,
        response: str,
        *,
        turn_id: int,
        on_stream_chunk: Callable[[str], None] | None = None,
    ) -> None:
        text = str(response or "")
        if not text:
            with self._lock:
                self._streaming_text = ""
            return
        words = text.split(" ")
        chunk_size = max(1, min(6, len(words) // 4 or 1))
        built: list[str] = []
        for idx in range(0, len(words), chunk_size):
            with self._lock:
                if turn_id != self._turn_id or self._turn_cancel_event.is_set():
                    self._streaming_text = ""
                    return
                piece = " ".join(words[idx : idx + chunk_size])
                built.append(piece)
                self._streaming_text = " ".join(built)
            if on_stream_chunk is not None:
                try:
                    on_stream_chunk(piece)
                except Exception:
                    pass
            self._notify_observers()
        with self._lock:
            self._streaming_text = ""

    def send_text(
        self,
        user_input: str,
        *,
        speak: bool | None = None,
        on_stream_chunk: Callable[[str], None] | None = None,
    ) -> str:
        """Handle typed user text using the shared RIYAAssistant & transcript."""

        cleaned = strip_unsafe_control_chars(str(user_input), allow_newlines=True).strip()
        if not cleaned:
            return "Please tell me what you'd like me to do."

        if cleaned.lower().startswith("/task ") and len(cleaned) > 6:
            task_goal = cleaned[6:].strip()
            if task_goal:
                return self.run_voice_task(
                    task_goal,
                    speak_progress=bool(speak) if speak is not None else (self.mode == "voice"),
                )

        with self._lock:
            if self.state in (VoiceState.SPEAKING, VoiceState.THINKING):
                self.interrupt("text_input_override")
            self._turn_id += 1
            turn_id = self._turn_id
            self._turn_cancel_event.clear()
            self._streaming_text = ""

        self.session.append_transcript(role="user", text=cleaned, modality="text")

        was_listening = self.state == VoiceState.LISTENING
        if was_listening:
            self.state_machine.try_transition(VoiceState.THINKING, "text_message_thinking")

        with self._lock:
            if turn_id != self._turn_id or self._turn_cancel_event.is_set():
                return ""
            if hasattr(self.assistant, "reset_cancel"):
                self.assistant.reset_cancel()

        pending_before = getattr(self.assistant, "pending_action", None)
        had_pending_before = pending_before is not None
        previous_token = (
            pending_before.get("confirmation_token") or pending_before.get("token")
            if isinstance(pending_before, dict)
            else None
        )

        try:
            response = self.assistant.process(cleaned)
        except InferenceCancelledError:
            self._rollback_interrupted_pending_action(had_pending_before, previous_token)
            if was_listening and self.state == VoiceState.THINKING:
                self.state_machine.try_transition(VoiceState.INTERRUPTED, "text_inference_cancelled")
                self.state_machine.try_transition(VoiceState.LISTENING, "ready")
            self._notify_observers()
            return ""

        with self._lock:
            stale = turn_id != self._turn_id or self._turn_cancel_event.is_set()
        if stale:
            self._rollback_interrupted_pending_action(had_pending_before, previous_token)
            return ""

        self._emit_progressive_chunks(
            response,
            turn_id=turn_id,
            on_stream_chunk=on_stream_chunk,
        )
        entry = self.session.append_transcript(role="assistant", text=response, modality="text")

        # Sync active task progress if a pending task step was confirmed or rejected via text.
        if had_pending_before and isinstance(pending_before, dict) and pending_before.get("task_id"):
            task_id_sync = str(pending_before["task_id"])
            store = getattr(self.assistant, "task_store", None)
            identity = self._resolve_active_identity()
            if store is not None and identity is not None:
                try:
                    rec = store.get_task(identity, task_id_sync)
                    if isinstance(rec, dict):
                        plan_obj = rec.get("plan")
                        steps_list = getattr(plan_obj, "steps", ()) or ()
                        done_cnt = sum(
                            1
                            for s in steps_list
                            if getattr(getattr(s, "status", None), "value", str(getattr(s, "status", ""))) == "completed"
                        )
                        plan_status_obj = getattr(plan_obj, "status", None)
                        rec_status = str(
                            rec.get("status")
                            or getattr(plan_status_obj, "value", str(plan_status_obj or "completed"))
                        )
                        rec_goal = str(rec.get("goal") or getattr(plan_obj, "goal", ""))
                        with self._lock:
                            self._active_task_progress = {
                                "event": f"task_{rec_status}",
                                "task_id": task_id_sync,
                                "goal": rec_goal,
                                "status": rec_status,
                                "steps_completed": done_cnt,
                                "steps_total": len(steps_list),
                                "requires_confirmation": bool(rec.get("requires_confirmation", False)),
                                "message": response,
                            }
                except Exception:
                    pass

        should_speak = (
            self.mode == "voice" and self.config.voice_responses_enabled
            if speak is None
            else bool(speak)
        )
        if should_speak and self.state == VoiceState.THINKING:
            self._speak_response(response, turn_id=turn_id, entry=entry)
        elif was_listening and self.state == VoiceState.THINKING:
            self.state_machine.try_transition(VoiceState.LISTENING, "text_turn_complete")

        self._notify_observers()
        return response

    def correct_last_user_transcript(self, corrected_text: str) -> str | None:
        """Update the latest user transcript entry and process the correction safely."""

        cleaned = strip_unsafe_control_chars(str(corrected_text), allow_newlines=True).strip()
        if not cleaned:
            return None
        entries = self.session.transcript_entries()
        last_user = next((e for e in reversed(entries) if e.role == "user"), None)
        if last_user is not None:
            self.session.update_transcript(last_user.entry_id, text=cleaned, status="corrected")
        if hasattr(self.assistant, "reset_cancel"):
            self.assistant.reset_cancel()
        response = self.assistant.process(cleaned)
        self.session.append_transcript(role="assistant", text=response, modality=self.mode)
        self._notify_observers()
        return response

    def handle_utterance_audio(
        self,
        audio: np.ndarray,
        *,
        turn_id: int | None = None,
    ) -> str | None:
        """Process one captured 16 kHz utterance synchronously (used by worker & tests)."""

        with self._lock:
            if turn_id is None:
                self._turn_id += 1
                turn_id = self._turn_id
                self._turn_cancel_event.clear()
            if turn_id != self._turn_id or self._turn_cancel_event.is_set():
                return None

        if self.state == VoiceState.IDLE:
            raise RuntimeError("Voice session must be active before handling voice audio.")

        # Ensure optional disk retention respects privacy settings strictly.
        self.session.maybe_save_recording(audio)

        if self.state != VoiceState.TRANSCRIBING:
            if not self.state_machine.try_transition(VoiceState.TRANSCRIBING, "speech_captured"):
                return None
        self._notify_observers()

        try:
            self._enforce_voice_permission("voice.microphone", resource="voice:microphone")
            stt_result = self.stt.transcribe_detailed(audio, language=self.config.stt_language)
        except Exception as exc:
            msg = exc.user_message if isinstance(exc, VoiceError) else "I couldn't understand that audio."
            self._record_nonfatal_turn_error(msg)
            return msg

        if not self._is_turn_active(turn_id):
            return None

        transcript_text = (stt_result.text or "").strip() if isinstance(stt_result, TranscriptionResult) else str(stt_result).strip()
        if not transcript_text:
            self.state_machine.try_transition(VoiceState.LISTENING, "empty_transcription")
            self._notify_observers()
            return None

        if not self.state_machine.try_transition(VoiceState.THINKING, "transcription_ready"):
            return None

        self.session.append_transcript(
            role="user",
            text=transcript_text,
            modality="voice",
            language=getattr(stt_result, "language", self.config.language),
            confidence=getattr(stt_result, "confidence", None),
        )
        self._notify_observers()

        # Check explicit voice task cancellation before normal routing.
        norm_voice_cmd = transcript_text.lower().strip().rstrip(".!?")
        if norm_voice_cmd in {"cancel task", "cancel the task", "stop task", "abort task"}:
            self.interrupt("voice_cancel_task")
            if hasattr(self.assistant, "_clear_pending_confirmations"):
                try:
                    self.assistant._clear_pending_confirmations()
                except Exception:
                    pass
            coord = getattr(self.assistant, "coordinator", None)
            if coord is not None and hasattr(coord, "cancel_all_active"):
                coord.cancel_all_active()
            cancelled_msg = "Cancelled the active task."
            entry = self.session.append_transcript(role="assistant", text=cancelled_msg, modality="voice")
            self._finish_voice_turn(cancelled_msg, turn_id=turn_id, entry=entry)
            return cancelled_msg

        # Secure voice confirmation gate when assistant holds pending_action.
        if getattr(self.assistant, "pending_action", None) is not None:
            gated = self._check_voice_confirmation_gate(stt_result)
            if gated is not None:
                entry = self.session.append_transcript(role="assistant", text=gated, modality="voice")
                self._finish_voice_turn(gated, turn_id=turn_id, entry=entry)
                return gated

        with self._lock:
            if not self._is_turn_active(turn_id):
                return None
            if hasattr(self.assistant, "reset_cancel"):
                self.assistant.reset_cancel()

        pending_before = getattr(self.assistant, "pending_action", None)
        had_pending_before = pending_before is not None
        previous_token = (
            pending_before.get("confirmation_token") or pending_before.get("token")
            if isinstance(pending_before, dict)
            else None
        )

        try:
            response = self.assistant.process(transcript_text)
        except InferenceCancelledError:
            self._rollback_interrupted_pending_action(had_pending_before, previous_token)
            if self.state == VoiceState.THINKING:
                self.state_machine.try_transition(VoiceState.INTERRUPTED, "inference_cancelled")
                self.state_machine.try_transition(VoiceState.LISTENING, "ready")
            self._notify_observers()
            return None
        except Exception:
            self._rollback_interrupted_pending_action(had_pending_before, previous_token)
            msg = "I encountered an internal error processing that request, so nothing was executed."
            self._record_nonfatal_turn_error(msg)
            return msg

        # Discard stale AI response and roll back newly staged confirmations if interrupted.
        if not self._is_turn_active(turn_id):
            logger.debug("Discarding stale response from turn %s", turn_id)
            self._rollback_interrupted_pending_action(had_pending_before, previous_token)
            return None

        entry = self.session.append_transcript(role="assistant", text=response, modality="voice")
        self._finish_voice_turn(response, turn_id=turn_id, entry=entry)
        return response

    def _rollback_interrupted_pending_action(
        self,
        had_pending_before: bool,
        previous_token: str | None,
    ) -> None:
        """Clear any unconfirmed pending_action staged by a cancelled turn."""

        pending_after = getattr(self.assistant, "pending_action", None)
        if pending_after is None:
            return
        after_token = (
            pending_after.get("confirmation_token") or pending_after.get("token")
            if isinstance(pending_after, dict)
            else None
        )
        if had_pending_before and after_token == previous_token:
            return

        agent = getattr(self.assistant, "agent", None)
        if isinstance(after_token, str) and after_token and agent is not None:
            cancel_fn = getattr(agent, "cancel_confirmation", None)
            if callable(cancel_fn):
                try:
                    cancel_fn(after_token)
                except Exception:
                    pass
        try:
            self.assistant.pending_action = None
            if hasattr(self.assistant, "pending_plan"):
                self.assistant.pending_plan = None
        except Exception:
            pass

    def _check_voice_confirmation_gate(self, stt_result: Any) -> str | None:
        if not self.config.voice_confirmation_enabled:
            return (
                "Voice confirmation is disabled for protected actions. "
                "Please reply yes or no using text."
            )
        confidence = getattr(stt_result, "confidence", None)
        if confidence is not None and confidence < self.config.min_confirmation_confidence:
            return (
                "I didn't catch that clearly enough to confirm a protected action. "
                "Please clearly say yes to proceed or no to cancel."
            )
        normalized = str(getattr(stt_result, "text", "")).lower().strip().rstrip(".!?")
        if normalized not in _YES_TOKENS and normalized not in _NO_TOKENS:
            return "Please clearly say yes to proceed or no to cancel."
        return None

    def _finish_voice_turn(self, response: str, *, turn_id: int, entry: TranscriptEntry) -> None:
        if self.config.voice_responses_enabled and self._is_turn_active(turn_id):
            self._speak_response(response, turn_id=turn_id, entry=entry)
        elif self.state == VoiceState.THINKING:
            self.state_machine.try_transition(VoiceState.LISTENING, "voice_responses_disabled")
        self._notify_observers()

    def _speak_response(self, response: str, *, turn_id: int, entry: TranscriptEntry) -> None:
        try:
            self._enforce_voice_permission(
                "voice.speaker", resource="voice:speaker", consume=True
            )
        except VoicePermissionError as exc:
            with self._lock:
                self._last_error = exc.user_message
            if self.state == VoiceState.THINKING:
                target_state = (
                    VoiceState.LISTENING if self.mode == "voice" else VoiceState.IDLE
                )
                self.state_machine.try_transition(target_state, "voice_speaker_blocked")
            self._notify_observers()
            return
        if not self.state_machine.try_transition(VoiceState.SPEAKING, "tts_started"):
            return
        self.segmenter.notify_playback_started()
        self._notify_observers()

        spoken_text = prepare_text_for_speech(
            response,
            style=self.config.response_style,
            max_chars=self.config.max_spoken_chars,
        )
        chunks = split_into_speech_chunks(
            spoken_text,
            max_chunk_chars=self.config.speech_chunk_chars,
        )
        spoken_so_far: list[str] = []

        def _on_chunk_done(_idx: int, chunk: str) -> None:
            spoken_so_far.append(chunk)
            self.session.update_transcript(
                entry.entry_id,
                spoken_text=" ".join(spoken_so_far),
            )
            self._notify_observers()

        try:
            completed = self.player.play_text_chunks(
                chunks,
                style=self.config.response_style,
                temp_dir=self.session.temp_dir,
                turn_check=lambda: self._is_turn_active(turn_id),
                on_chunk_done=_on_chunk_done,
            )
            if not completed or not self._is_turn_active(turn_id):
                self.session.update_transcript(entry.entry_id, status="interrupted")
                if self.state == VoiceState.SPEAKING:
                    self.state_machine.try_transition(VoiceState.INTERRUPTED, "playback_interrupted")
                    self.state_machine.try_transition(VoiceState.LISTENING, "ready")
                return

            self.state_machine.try_transition(VoiceState.LISTENING, "playback_finished")
        except Exception as exc:
            msg = exc.user_message if isinstance(exc, VoiceError) else "Speech playback failed; see transcript."
            with self._lock:
                self._last_error = msg
            self.session.update_transcript(entry.entry_id, status="error")
            if self.state in ACTIVE_STATES:
                self.state_machine.try_transition(VoiceState.LISTENING, "recovered_after_tts_error")
        finally:
            self._notify_observers()

    def _record_nonfatal_turn_error(self, message: str) -> None:
        with self._lock:
            self._last_error = message
        self.session.append_transcript(role="assistant", text=message, modality="voice", status="error")
        if self.state in (VoiceState.TRANSCRIBING, VoiceState.THINKING, VoiceState.SPEAKING):
            self.state_machine.try_transition(VoiceState.LISTENING, "recovered_from_turn_error")
        self._notify_observers()

    # ------------------------------------------------------------------
    def _audio_capture_loop(self) -> None:
        while not self._stop_threads.is_set() and self.state in ACTIVE_STATES:
            mic = self.session.microphone
            if mic is None or not mic.is_active:
                break
            try:
                frame = mic.read_frame(timeout=0.05)
            except VoiceError as exc:
                self._handle_fatal_audio_error(exc.user_message)
                return
            except Exception:
                self._handle_fatal_audio_error("Voice input encountered an unexpected error.")
                return

            if frame is None:
                continue

            current_state = self.state
            event = self.segmenter.process_frame(
                frame,
                assistant_speaking=(current_state == VoiceState.SPEAKING),
            )
            if event.barge_in_triggered:
                self.interrupt("user_barge_in")

            if event.speech_ended and event.utterance is not None:
                with self._lock:
                    if not event.barge_in_triggered and self.state != VoiceState.INTERRUPTED:
                        pass
                    self._turn_cancel_event.clear()
                    self._turn_id += 1
                    tid = self._turn_id
                try:
                    self._utterance_queue.put((event.utterance, tid), timeout=0.1)
                except queue.Full:
                    pass

    def _turn_worker_loop(self) -> None:
        while not self._stop_threads.is_set():
            try:
                utterance, tid = self._utterance_queue.get(timeout=0.1)
            except queue.Empty:
                continue
            if self._stop_threads.is_set():
                return
            self.handle_utterance_audio(utterance, turn_id=tid)

    def _handle_fatal_audio_error(self, message: str) -> None:
        with self._lock:
            self._last_error = message
            self._mode = "text"
            self._turn_id += 1
            self._turn_cancel_event.set()
            self._stop_threads.set()
        self.player.stop()
        self.session.stop(to_error=True)
        self.session.recover_from_error()
        self._notify_observers()

    def close(self) -> None:
        self.stop_voice_mode()
        self.session.close()

    @property
    def active_task_progress(self) -> dict[str, Any] | None:
        with self._lock:
            return dict(self._active_task_progress) if self._active_task_progress is not None else None

    @property
    def task_progress_history(self) -> list[dict[str, Any]]:
        with self._lock:
            return [dict(item) for item in self._task_progress_history]

    @property
    def last_task_result(self) -> Any:
        with self._lock:
            return self._last_task_result

    def _on_task_progress(self, event: dict[str, Any]) -> None:
        snap_ev = dict(event)
        with self._lock:
            self._active_task_progress = snap_ev
            self._task_progress_history.append(snap_ev)
            if len(self._task_progress_history) > 100:
                del self._task_progress_history[:-100]
        self._notify_observers()

    def run_voice_task(self, request: str, *, speak_progress: bool = True) -> str:
        """Execute an autonomous task via VoiceOrchestrator with live progress & cancellation."""
        cleaned = strip_unsafe_control_chars(str(request), allow_newlines=True).strip()
        if not cleaned:
            return "Please specify the task you want me to perform."

        if hasattr(self.assistant, "reset_cancel"):
            self.assistant.reset_cancel()

        with self._lock:
            self._task_progress_history = []
            self._last_task_result = None

        entry_modality = "voice" if self.mode == "voice" else "text"
        self.session.append_transcript(role="user", text=cleaned, modality=entry_modality)
        progress_notes: list[str] = []

        def _cb(event: dict[str, Any]) -> None:
            self._on_task_progress(event)
            msg = str(event.get("message") or "").strip()
            if msg:
                progress_notes.append(msg)

        if hasattr(self.assistant, "run_autonomous_task"):
            task_res = self.assistant.run_autonomous_task(cleaned, progress_callback=_cb)
            with self._lock:
                self._last_task_result = task_res
            response = (
                self.assistant._format_task_result(task_res)
                if hasattr(self.assistant, "_format_task_result")
                else str(getattr(task_res, "summary", "") or task_res)
            )
            status_val = getattr(getattr(task_res, "status", None), "value", str(getattr(task_res, "status", "completed")))
            prev_ev = (
                self._active_task_progress.get("event")
                if isinstance(self._active_task_progress, dict)
                else None
            )
            final_prog = {
                "event": str(prev_ev or f"task_{status_val}"),
                "task_id": getattr(task_res, "task_id", ""),
                "goal": getattr(task_res, "goal", cleaned),
                "status": status_val,
                "steps_completed": int(getattr(task_res, "steps_completed", 0)),
                "steps_total": int(getattr(task_res, "steps_total", 0)),
                "requires_confirmation": bool(getattr(task_res, "requires_confirmation", False)),
                "verified": bool(getattr(task_res, "verified", False)),
                "message": response,
                "step_results": list(getattr(task_res, "step_results", ()) or ()),
            }
            self._on_task_progress(final_prog)
            if hasattr(self.assistant, "_update_context"):
                try:
                    self.assistant._update_context(cleaned, response)
                except Exception:
                    pass
        else:
            response = self.assistant.process(cleaned)

        entry = self.session.append_transcript(role="assistant", text=response, modality=entry_modality)
        if speak_progress and self.mode == "voice" and self.config.voice_responses_enabled:
            with self._lock:
                self._turn_id += 1
                tid = self._turn_id
                self._turn_cancel_event.clear()
            if self.state == VoiceState.LISTENING:
                self.state_machine.try_transition(VoiceState.THINKING, "voice_task_ready")
            self._speak_response(response, turn_id=tid, entry=entry)
        self._notify_observers()
        return response

    def hydrate_user_history(self, limit: int = 50) -> list[TranscriptEntry]:
        """Hydrate the active user's persisted conversation history into the session transcript."""
        identity = self._resolve_active_identity()
        if identity is None:
            return self.session.transcript_entries()
        existing = self.session.transcript_entries()
        if existing:
            return existing
        history_store = getattr(self.assistant, "history_store", None)
        if history_store is None:
            return existing
        try:
            rows = history_store.get_history(identity, limit=limit)
        except Exception:
            rows = []
        for row in rows:
            role = str(row.get("role", "")).strip()
            content = str(row.get("content", "")).strip()
            if role in {"user", "assistant"} and content:
                self.session.append_transcript(
                    role=role,
                    text=content,
                    modality="text",
                    status="history",
                )
        return self.session.transcript_entries()

    def switch_identity(
        self,
        identity: Any | None,
        *,
        config: VoiceConfig | None = None,
    ) -> None:
        """Cancel active turns, drop to safe text mode, and rebind to the new user session."""
        self.interrupt("user_switch")
        with self._lock:
            self._explicit_identity = identity
            self._mode = "text"
            self._turn_id += 1
            self._turn_cancel_event.set()
            self._last_error = None
            self._streaming_text = ""
            self._active_task_progress = None
            self._task_progress_history = []
            self._last_task_result = None
            if config is not None:
                self.config = config
        self.session.stop(to_error=False)
        user_id = getattr(identity, "user_id", None) if identity is not None else None
        auth_session_id = getattr(identity, "session_id", None) if identity is not None else None
        self.session.bind_user(user_id, auth_session_id, config=config)
        self.hydrate_user_history()
        self._notify_observers()
