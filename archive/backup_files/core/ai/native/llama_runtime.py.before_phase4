import ctypes
from pathlib import Path


class NativeLlamaRuntime:
    VALID_BACKENDS = {"auto", "metal", "cpu"}

    def __init__(
        self,
        model_path: str,
        context_size: int = 4096,
        backend: str = "auto",
    ):
        if backend not in self.VALID_BACKENDS:
            raise ValueError(
                f"Invalid backend '{backend}'. "
                f"Choose from {sorted(self.VALID_BACKENDS)}."
            )

        self.handle = None
        self.backend = "unloaded"

        project_root = Path(__file__).resolve().parents[3]
        bridge_path = (
            project_root / "core" / "ai" / "native"
            / "bridge" / "libriya_llama.dylib"
        )

        if not bridge_path.is_file():
            raise FileNotFoundError(
                f"RIYA native bridge not found: {bridge_path}"
            )

        model_path = Path(model_path).expanduser().resolve()
        if not model_path.is_file():
            raise FileNotFoundError(f"Model not found: {model_path}")

        self.lib = ctypes.CDLL(str(bridge_path))

        self.lib.riya_load_model_with_backend.argtypes = [
            ctypes.c_char_p,
            ctypes.c_int32,
            ctypes.c_char_p,
        ]
        self.lib.riya_load_model_with_backend.restype = ctypes.c_void_p

        self.lib.riya_get_backend.argtypes = [ctypes.c_void_p]
        self.lib.riya_get_backend.restype = ctypes.c_char_p

        self.lib.riya_free_model.argtypes = [ctypes.c_void_p]
        self.lib.riya_free_model.restype = None

        self.lib.riya_generate.argtypes = [
            ctypes.c_void_p,
            ctypes.c_char_p,
            ctypes.c_char_p,
            ctypes.c_int32,
            ctypes.c_int32,
        ]
        self.lib.riya_generate.restype = ctypes.c_int

        self.handle = self.lib.riya_load_model_with_backend(
            str(model_path).encode("utf-8"),
            context_size,
            backend.encode("ascii"),
        )

        if not self.handle:
            raise RuntimeError(
                f"RIYA failed to load model using '{backend}'."
            )

        selected = self.lib.riya_get_backend(self.handle)
        self.backend = (
            selected.decode("ascii") if selected else "unknown"
        )

    def generate(self, prompt: str, max_tokens: int = 128) -> str:
        if not self.handle:
            raise RuntimeError("Native model is not loaded.")

        output = ctypes.create_string_buffer(16384)
        result = self.lib.riya_generate(
            self.handle,
            prompt.encode("utf-8"),
            output,
            len(output),
            max_tokens,
        )

        if result < 0:
            raise RuntimeError(
                f"RIYA generation failed with code {result}"
            )

        return output.value.decode(
            "utf-8", errors="replace"
        ).strip()

    def close(self):
        if self.handle:
            self.lib.riya_free_model(self.handle)
            self.handle = None
        self.backend = "unloaded"

    def __del__(self):
        try:
            self.close()
        except Exception:
            pass
